# Copy to deploy.env (ignored by git) and fill in. Used by scripts/deploy-site.sh.
DEPLOY_HOST=user@your-vps.example.com
DEPLOY_PORT=22
# The page's name and its own web root (only this folder is written).
DEPLOY_NAME=celestron-aux.patriciolatini.com
DEPLOY_ROOT=/var/www/celestron-aux.patriciolatini.com
# Owner of the uploaded files and where backups of the replaced page go on the server.
DEPLOY_OWNER=www-data:www-data
BACKUP_DIR=/var/backups/celestron-aux
